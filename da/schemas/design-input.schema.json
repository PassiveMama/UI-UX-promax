{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dockeryautomations.com/schemas/design-input.schema.json",
  "title": "DA UI/UX Design Intelligence Input",
  "type": "object",
  "required": ["request_id", "client", "website", "audience", "brand", "implementation"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "client": {
      "type": "object",
      "required": ["client_id", "display_name"],
      "properties": {
        "client_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "industry": {"type": "string"}
      },
      "additionalProperties": true
    },
    "website": {
      "type": "object",
      "required": ["primary_goal", "approved_scope", "pages", "calls_to_action"],
      "properties": {
        "primary_goal": {"type": "string", "minLength": 1},
        "approved_scope": {"type": "string", "minLength": 1},
        "pages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "calls_to_action": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "required_integrations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "audience": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "secondary": {"type": "array", "items": {"type": "string"}},
        "needs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "brand": {
      "type": "object",
      "required": ["voice", "constraints"],
      "properties": {
        "voice": {"type": "array", "items": {"type": "string"}},
        "approved_colors": {"type": "array", "items": {"type": "string"}},
        "approved_typography": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "prohibited": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "implementation": {
      "type": "object",
      "required": ["build_platform"],
      "properties": {
        "build_platform": {"type": "string", "minLength": 1},
        "design_platform": {"type": "string"},
        "accessibility_target": {"type": "string"},
        "responsive_targets": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "governing_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": {"type": "string"},
          "version": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}
